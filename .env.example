# Supabase project URL and anon key for the main app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: URL to the deployed edge function that returns today's booked games.
# If empty, the app will use:
#   ${VITE_SUPABASE_URL}/functions/v1/get-today-booked-games
# Example:
# VITE_BOOKED_GAMES_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/get-today-booked-games
VITE_BOOKED_GAMES_ENDPOINT=
